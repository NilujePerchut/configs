root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

[*.lua]
indent_style = space
indent_size = 2

[*.nix]
indent_style = space
indent_size = 2

[*.{sh,zsh,bash}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.vim]
indent_style = space
indent_size = 2

[*.conf]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
